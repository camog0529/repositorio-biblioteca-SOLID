<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="900.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
            fx:controller="co.edu.uniquindio.controlador.BibliotecaController">
    <children>
        <HBox spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0"
              AnchorPane.topAnchor="15.0">
            <children>
                <!-- SECCIÓN IZQUIERDA: Formulario de Registro (Builder) -->
                <VBox prefWidth="300.0" spacing="12.0"
                      style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;">
                    <children>
                        <Label text="Registro de Libros">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Label>
                        <Label text="Código (Obligatorio)"/>
                        <TextField fx:id="txtCodigo" promptText="Ej: L001"/>
                        <Label text="Título (Obligatorio)"/>
                        <TextField fx:id="txtTitulo" promptText="Ej: Cien años de soledad"/>
                        <Label text="Autor (Opcional)"/>
                        <TextField fx:id="txtAutor" promptText="Ej: Gabriel García Márquez"/>
                        <Label text="Categoría (Opcional)"/>
                        <TextField fx:id="txtCategoria" promptText="Ej: Novela"/>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                onAction="#manejarRegistrarLibro"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"
                                text="Registrar Libro">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>

                <!-- SECCIÓN DERECHA: Tabla y Acciones (Singleton, Prototype, SOLID) -->
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="2.0"
                              style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e9ecef; -fx-border-radius: 5;">
                            <children>
                                <Label fx:id="lblNombreBiblioteca" text="Nombre de la Biblioteca">
                                    <font>
                                        <Font name="System Bold" size="18.0"/>
                                    </font>
                                </Label>
                                <Label fx:id="lblDireccion" text="Dirección" textFill="#6c757d"/>
                            </children>
                        </VBox>
                        <TableView fx:id="tblLibros" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código"/>
                                <TableColumn fx:id="colTitulo" prefWidth="180.0" text="Título"/>
                                <TableColumn fx:id="colAutor" prefWidth="130.0" text="Autor"/>
                                <TableColumn fx:id="colCategoria" prefWidth="100.0" text="Categoría"/>
                                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado"/>
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#manejarClonarLibro"
                                        style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold;"
                                        text="Clonar Seleccionado"/>
                                <Button mnemonicParsing="false" onAction="#manejarPrestarLibro"
                                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"
                                        text="Prestar Libro"/>
                                <Button mnemonicParsing="false" onAction="#manejarDevolverLibro"
                                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;"
                                        text="Devolver Libro"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>